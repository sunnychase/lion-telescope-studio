# Lion Telescope Studio settings. Copy to telescope.env and edit; the systemd unit in systemd/ reads it,
# or load it by hand:  set -a; . ./telescope.env; set +a; python3 server.py
# Every setting is optional; the defaults are shown.

# Address to listen on. 127.0.0.1 = this computer only (recommended). 0.0.0.0 = every device on your network
# (there is no login: only do this on a network you trust, or put it behind an authenticating proxy).
SKY_HOST=127.0.0.1

# Port.
SKY_PORT=8650

# Where the server keeps its cache of upstream answers (point reports, schedules, sky maps, the Sun...).
# Default: cache/ next to server.py. A few hundred MB at most.
#SKY_CACHE_DIR=~/.cache/lion-telescope-studio

# Optional: the CelesTrak cache folder of a Lion Satellite Studio on the same machine
# (its cache/celestrak). Read-only; saves downloading the same orbital elements twice. Unset = not used.
#SKY_SHARED_CELESTRAK_DIR=~/lion-satellite-studio/cache/celestrak
